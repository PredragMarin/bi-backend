    "technology_unit_id": { "type": "string" },
    "compatible_family_ids": { "type": "array", "items": { "type": "string" } },
    "depends_on_rule_sets": { "type": "array", "items": { "type": "string" } },
    "family_property_refs": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}

