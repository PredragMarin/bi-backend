{
  "catalog_id": "rule_catalog_mxd_door_v0",
  "schema_version": "rule_catalog.v0",
  "profile_id": "MXD_DOOR_V0",
  "source": "initial_mxd_kskr_authoring",
  "rules": {
    "MXD_LAYER_B_OFFSET_9P5": {
      "rule_id": "MXD_LAYER_B_OFFSET_9P5",
      "label": "Layer B offset +9.5 mm",
      "profile_scope": "MXD",
      "description": "Ako je MODEL_VRATA u [Europa, EuroMax] (legacy alias TIP_VRATA), pomakni BASE branch Layer B entitete za +9.5 mm po osi Y i primijeni bounded local trim/rejoin unutar fixed envelope preview logike.",
      "condition": {
        "parameter": "MODEL_VRATA",
        "operator": "IN",
        "values": [
          "Europa",
          "EuroMax"
        ]
      },
      "target_scope": {
        "layer": "B",
        "geometry_branch": "BASE"
      },
      "action": {
        "geometry": "offset",
        "axis": "Y",
        "value_mm": 9.5,
        "post_repair": "bounded_trim_rejoin"
      },
      "status": "draft"
    },
    "MICRO_SHIFT_SET_X": {
      "rule_id": "MICRO_SHIFT_SET_X",
      "label": "Post-TOPO micro shift X",
      "profile_scope": "MXD",
      "description": "Nakon document SEM i TOPO materializacije pomakni sve entitete označene SEM:post_topo_group=MICRO_SHIFT_SET kao rigidni skup po X osi. Pozitivna vrijednost SKRACENJE skraćuje LBRA, pa se primjenjuje kao -SKRACENJE po X osi.",
      "target_scope": {
        "post_topo_group": "MICRO_SHIFT_SET"
      },
      "action": {
        "stage": "post_topo",
        "geometry": "offset",
        "axis": "X",
        "value_expr": "-SKRACENJE",
        "unit": "mm",
        "default": 0,
        "post_repair": "bounded_trim_rejoin"
      },
      "status": "draft"
    },
    "S4P4_LBRA_LABEL_APPLICATION": {
      "rule_id": "S4P4_LBRA_LABEL_APPLICATION",
      "label": "S4P4 LBRA label application",
      "profile_scope": "MXD",
      "description": "Postavi production label application envelope za LBRA. DXF TEXT je downstream payload carrier; label envelope se koristi za placement i collision preview.",
      "target_scope": {
        "family": "VRATA",
        "products": [
          "*"
        ],
        "parts": [
          "LBRA"
        ]
      },
      "action": {
        "stage": "child_label",
        "priority": 100,
        "operation": "apply_label",
        "coordinate_space": "raw_part",
        "anchor_transform": "through_final_child",
        "label_width": 50,
        "label_height": 20,
        "rotation": 0,
        "collision_policy": "warn",
        "payload_carrier": "TEXT",
        "carrier_layer": "0",
        "carrier_height": 1,
        "carrier_color": 1,
        "carrier_h_align": 1,
        "carrier_v_align": 2,
        "payload_template": ";|{{WORKORDERCODE}}|{{MODEL_VRATA}}|{{SOURCE_REFERENCE}}|{{DIMENSION_SHORT}}|{{OPENING_SIDE_SHORT}}",
        "payload_fields": {
          "DIMENSION_SHORT": "format({{SIRINA_VRATA_DIV10}}x{{VISINA_VRATA_DIV10}})",
          "SIRINA_VRATA_DIV10": "number_expr(SIRINA_VRATA/10,integer)",
          "VISINA_VRATA_DIV10": "number_expr(VISINA_VRATA/10,integer)",
          "OPENING_SIDE_SHORT": "map(STRANA_OTVARANJA:{Desna (DX)=D,Lijeva (SX)=L,Inverzna desna (INV DX)=D,Inverzna lijeva (INV SX)=L})"
        }
      },
      "status": "draft"
    },
    "DOOR_SX_DX_MIRROR": {
      "rule_id": "DOOR_SX_DX_MIRROR",
      "label": "Deprecated alias - use explicit X/Y SX-DX mirror rule",
      "profile_scope": "OPS_S4P4",
      "description": "Deprecated compatibility alias for older sessions. New authoring must choose DOOR_SX_DX_MIRROR_X_UNSTACKED or DOOR_SX_DX_MIRROR_Y_STACKED explicitly.",
      "target_scope": {
        "family": "VRATA",
        "products": [
          "*"
        ],
        "parts": [
          "*"
        ]
      },
      "condition": {
        "parameter": "STRANA_OTVARANJA",
        "operator": "IN",
        "values": [
          "Lijeva (SX)",
          "Inverzna lijeva (INV SX)"
        ]
      },
      "action": {
        "stage": "final_orientation",
        "priority": 100,
        "geometry": "mirror",
        "axis": "X",
        "normalize_bbox": true,
        "text_policy": "keep_upright"
      },
      "status": "deprecated",
      "ui_hidden": true
    },
    "KSKR_HIDDEN_CLOSER_LEFT_SHORTEN": {
      "rule_id": "KSKR_HIDDEN_CLOSER_LEFT_SHORTEN",
      "label": "KSKR hidden closer left band +5 mm",
      "profile_scope": "OPS_S4P4",
      "description": "Za KSKR, ako je HIDRAULICKI_ZATVARAC Skriveni, korigiraj finalni 4-band L offset za dodatnih +5 mm po X osi prije egzekucije band movementa.",
      "target_scope": {
        "family": "VRATA",
        "products": [
          "PPV"
        ],
        "parts": [
          "KSKR"
        ]
      },
      "condition": {
        "parameter": "HIDRAULICKI_ZATVARAC",
        "operator": "==",
        "value": "Skriveni"
      },
      "action": {
        "stage": "topology_delta_modifier",
        "target_band": "L",
        "axis": "X",
        "delta": 5,
        "unit": "mm",
        "corner_scope": "derived_adjacent"
      },
      "status": "draft"
    },
    "KSKR_EXTERNAL_DOOR_RIGHT_SHORTEN": {
      "rule_id": "KSKR_EXTERNAL_DOOR_RIGHT_SHORTEN",
      "label": "KSKR external door right band -30 mm",
      "profile_scope": "OPS_S4P4",
      "description": "Za KSKR, ako je VANJSKA_VRATA Da, korigiraj finalni 4-band R offset za dodatnih -30 mm po X osi prije egzekucije band movementa.",
      "target_scope": {
        "family": "VRATA",
        "products": [
          "PPV"
        ],
        "parts": [
          "KSKR"
        ]
      },
      "condition": {
        "parameter": "VANJSKA_VRATA",
        "operator": "==",
        "value": "Da"
      },
      "action": {
        "stage": "topology_delta_modifier",
        "target_band": "R",
        "axis": "X",
        "delta": -30,
        "unit": "mm",
        "corner_scope": "derived_adjacent",
        "warning_on_superposition": true
      },
      "status": "draft"
    },
    "DOOR_SX_DX_MIRROR_X_UNSTACKED": {
      "rule_id": "DOOR_SX_DX_MIRROR_X_UNSTACKED",
      "label": "Door SX/DX mirror X - unstacked parts",
      "profile_scope": "OPS_S4P4",
      "condition": {
        "parameter": "STRANA_OTVARANJA",
        "operator": "IN",
        "values": [
          "Lijeva (SX)",
          "Inverzna lijeva (INV SX)"
        ]
      },
      "target_scope": {
        "family": "VRATA",
        "products": [
          "*"
        ],
        "parts": [
          "KSKR",
          "OBRA",
          "OSPY",
          "OBRIT",
          "OMET"
        ]
      },
      "status": "draft",
      "description": "Za nestackirane partove KSKR/OBRA/OSPY/OBRIT/OMET, Lijeva (SX) i Inverzna lijeva (INV SX) finalno mirroraju child geometriju oko X osi radi downstream left/right koordinatne konvencije.",
      "action": {
        "stage": "final_orientation",
        "priority": 100,
        "geometry": "mirror",
        "axis": "X",
        "normalize_bbox": true,
        "text_policy": "keep_upright"
      }
    },
    "DOOR_SX_DX_MIRROR_Y_STACKED": {
      "rule_id": "DOOR_SX_DX_MIRROR_Y_STACKED",
      "label": "Door SX/DX mirror Y - stacked parts",
      "profile_scope": "OPS_S4P4",
      "condition": {
        "parameter": "STRANA_OTVARANJA",
        "operator": "IN",
        "values": [
          "Lijeva (SX)",
          "Inverzna lijeva (INV SX)"
        ]
      },
      "target_scope": {
        "family": "VRATA",
        "products": [
          "*"
        ],
        "parts": [
          "LBRA",
          "LBRIT",
          "LHOR",
          "LMET",
          "SBRA",
          "SBRIT",
          "SHOR",
          "KDDV",
          "KDLV",
          "KDHOR",
          "PS"
        ]
      },
      "status": "draft",
      "description": "Za stackirane partove LBRA/LBRIT/LHOR/LMET/SBRA/SBRIT/SHOR/KDDV/KDLV/KDHOR/PS, Lijeva (SX) i Inverzna lijeva (INV SX) finalno mirroraju child geometriju oko Y osi radi downstream nesting konvencije.",
      "action": {
        "stage": "final_orientation",
        "priority": 100,
        "geometry": "mirror",
        "axis": "Y",
        "normalize_bbox": true,
        "text_policy": "keep_upright"
      }
    }
  }
}
