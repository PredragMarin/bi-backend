{
  "contract_id": "dbr_api_contract_v0",
  "module": "dbr_v1",
  "api_version": "v1",
  "base_path": "/api/dbr/v1",
  "status": "draft",
  "response_envelope": {
    "ok": "boolean",
    "data": "object|null",
    "error": {
      "code": "string",
      "message": "string",
      "details": "object|array|string|null"
    },
    "meta": {
      "requestId": "string",
      "timestamp": "ISO-8601 string",
      "version": "v1"
    }
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/orders",
      "summary": "Creates a BI-side DBR production order from a supplied frozen payload.",
      "request_body": {
        "gosoftDnId": "number|optional; generated by API when omitted",
        "gosoftDnKey": "string|optional",
        "parameterSnapshot": "object|optional; full request body is frozen when omitted",
        "status": "string|optional default=frozen"
      },
      "response_data": {
        "order": "dbrProductionOrder"
      }
    },
    {
      "method": "POST",
      "path": "/orders/:orderId/batches",
      "summary": "Atomically creates a kit batch and expanded part jobs for the requested product/profile.",
      "request_body": {
        "productCode": "string|required default_candidate=PPV",
        "technologyProfile": "string|required default_candidate=OPS_S4P4",
        "parameterSnapshot": "object|optional"
      },
      "response_data": {
        "batch": "dbrKitBatch",
        "jobs": "dbrPartJob[]"
      }
    },
    {
      "method": "GET",
      "path": "/batches/:batchId/report",
      "summary": "Returns a read-only batch status report with all part jobs.",
      "response_data": {
        "report": "dbrBatchReport"
      }
    },
    {
      "method": "POST",
      "path": "/batches/:batchId/run",
      "summary": "Execution boundary for DBR batch execution. Resolver execution is not implemented in v0.",
      "response_data": {
        "status": "not_implemented"
      }
    },
    {
      "method": "GET",
      "path": "/jobs/:jobId",
      "summary": "Returns read-only status for one part job.",
      "response_data": {
        "job": "dbrPartJob"
      }
    },
    {
      "method": "POST",
      "path": "/artifacts",
      "summary": "Registers an approved Mother DXF artifact for DBR lookup.",
      "request_body": {
        "productCode": "string|required",
        "partCode": "string|required",
        "technologyProfile": "string|required",
        "motherSessionId": "string|optional",
        "artifactPath": "string|required",
        "artifactHash": "string|optional",
        "approvalStatus": "string|optional default=approved",
        "approvedAt": "ISO-8601 string|optional",
        "approvedBy": "string|optional",
        "documentSem": "object|optional",
        "metadataSummary": "object|optional"
      },
      "response_data": {
        "artifact": "motherArtifactRegistryEntry"
      }
    }
  ],
  "boundaries": {
    "routes_call": "src/modules/dbr_v1/module_runtime.js",
    "routes_do_not_call": ["SQL", "pg", "core_shell/db/helpers/query.js"],
    "resolver_execution": "not_implemented",
    "erp_import": "not_implemented",
    "mother_dxf_session_storage": "not_modified"
  }
}
