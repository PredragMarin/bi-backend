{
  "identity": {
    "use_case": "eojn_v1",
    "contract_version": "1.1.0",
    "module_version": "0.2.0",
    "owner": "Marn Expert d.o.o."
  },
  "runtime": {
    "core_contract_ref": "core_contract_v1.0.x",
    "output_envelope_version": "1.0.0",
    "timezone": "Europe/Zagreb"
  },
  "inputs": {
    "datasets": [
      {
        "name": "eojn_procurements_raw",
        "role": "raw_fact",
        "provenance": "EOJN",
        "format": "json",
        "required": true,
        "notes": "Public procurements feed from /procurements-all."
      },
      {
        "name": "eojn_notices_raw",
        "role": "raw_fact",
        "provenance": "EOJN",
        "format": "json",
        "required": true,
        "notes": "Public notices feed from /notices-all."
      },
      {
        "name": "eojn_budget",
        "role": "raw_fact",
        "provenance": "EOJN",
        "format": "xlsx",
        "required": false,
        "notes": "Tender budget (Layer 2 evidence scan)."
      }
    ]
  },
  "outputs": {
    "artifacts_minimum": [
      "procurements_raw.json",
      "notices_raw.json",
      "raw.json",
      "scored.json",
      "shortlist.json",
      "layer2_queue.json",
      "manifest.json",
      "events.log"
    ],
    "artifacts_optional": [
      "layer2_evidence.json",
      "alerts_queue.csv"
    ]
  },
  "contracts": {
    "layer1_run_contract": "contracts/layer1_run_contract.json",
    "validation_entry": "validate_layer1_request.js",
    "layer1_semantic_rules": [
      "l1_cpv_rules_v1.json",
      "l1_contract_type_rules_v1.json",
      "l1_contracting_body_rules_v1.json",
      "l1_negative_semantics_v1.json",
      "l1_scope_taxonomy_v1.json",
      "l1_semantic_matrix_v1.json"
    ]
  },
  "storage": {
    "bi_store_root": "out/eojn_v1"
  },
  "policies": {
    "store_full_docs": false,
    "layer2_max_per_day": 50,
    "layer2_parallelism": 1
  },
  "module_adapter": {
    "adapter_file": "adapter.js",
    "hooks_allowed": ["transform", "postprocess"],
    "present": false
  }
}
