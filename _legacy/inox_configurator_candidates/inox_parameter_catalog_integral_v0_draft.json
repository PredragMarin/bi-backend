    "primary": "legacy_inox_configurator_candidates/schema_inox_v6.js",
    "secondary": "working_excel_parameter_template_screenshot",
    "notes": [
      "This draft replaces product-family repetition with base templates and feature extensions.",
      "Duljina and Sirina use commercial 100 mm steps. Visina uses 50 mm steps.",
      "Rules are referenced by id here, but implementation belongs to rule catalog/runtime."
    ]
  },
